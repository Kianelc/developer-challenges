# Database credentials (required, choose your own values)
POSTGRES_USER=
POSTGRES_PASSWORD=

# Database settings (non-sensitive defaults)
POSTGRES_DB=dynamox
POSTGRES_PORT=5432

# Prisma connection string. Must match the credentials above:
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# API
PORT=3000
# Generate one with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=1h